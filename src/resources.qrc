<!DOCTYPE RCC>
<RCC version="1.0">
    <!-- Embedded copy of the app icon, used for the window when the icon isn't
         installed in the icon theme (e.g. when running from the build directory). -->
    <qresource prefix="/icons">
        <file alias="konsole-ssh-manager.svg">../data/icons/ro.binarylogic.konsole-ssh-manager.svg</file>
    </qresource>
    <qresource prefix="/licenses">
        <file alias="MIT">../LICENSE</file>
    </qresource>
</RCC>
